<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:surface_type="surface_view"
        app:controller_layout_id="@layout/ck_controls"
        app:show_subtitle_button="true"
        app:show_buffering="always" />

    <!-- update banner: shows when the server has a newer build; click = download+install.
         Sits above the top overlay, auto-hides, never blocks playback. -->
    <Button
        android:id="@+id/btn_player_update"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="10dp"
        android:visibility="gone"
        android:textColor="#101018"
        android:backgroundTint="#F5C518" />

    <!-- top overlay: title left, clock + ends-at right; shown/hidden WITH the controller -->
    <LinearLayout
        android:id="@+id/top_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="24dp"
        android:background="@drawable/top_scrim">

        <TextView
            android:id="@+id/btn_back"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/ep_focus_bg"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:gravity="center"
            android:focusable="true"
            android:clickable="true"
            android:contentDescription="Back" />

        <TextView
            android:id="@+id/video_title"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Pop-out (Picture-in-Picture). Hidden by default; PlayerActivity shows it on mobile
             only (never the Firestick/TV UI). The Cast MediaRouteButton is inserted right here
             programmatically by the cast flavor, just before the clock column. -->
        <TextView
            android:id="@+id/btn_pip"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="6dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/ep_focus_bg"
            android:text="⧉"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:gravity="center"
            android:focusable="true"
            android:clickable="true"
            android:visibility="gone"
            android:contentDescription="Pop out" />

        <!-- AJ: current time with "Ends 10:48" right underneath it -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">
            <TextView
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/ends_at"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#BBBBCC"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- fps / playback info overlay (toggled by the info button) -->
    <TextView
        android:id="@+id/stats_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|top"
        android:layout_margin="24dp"
        android:layout_marginTop="80dp"
        android:padding="12dp"
        android:background="@drawable/panel_bg"
        android:textColor="#DDDDEE"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:visibility="gone" />

    <!-- episode drawer -->
    <FrameLayout
        android:id="@+id/episode_panel"
        android:layout_width="420dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#E6101018"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <!-- season tabs (AJ): pick a season, list below shows just that season.
                 Hidden for single-season shows. -->
            <HorizontalScrollView
                android:id="@+id/season_tabs_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="12dp"
                android:scrollbars="none"
                android:visibility="gone">
                <LinearLayout
                    android:id="@+id/season_tabs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/episode_recycler"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="12dp" />
        </LinearLayout>
        <!-- shown while the list is (re)fetching or failed — an empty dark drawer looked
             like the episode list had been removed entirely -->
        <TextView
            android:id="@+id/episode_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="24dp"
            android:textColor="#DDDDEE"
            android:textSize="16sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Captions side panel (AJ Sep 15): a slim, see-through list pinned to the right. Picking a
         track applies it LIVE and the panel STAYS OPEN, so you can walk the list and watch the
         captions on screen to find the one that actually lines up — it only closes on BACK.
         Narrow + translucent so the video and the bottom-centre captions stay visible behind it. -->
    <FrameLayout
        android:id="@+id/sub_side_panel"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#B3101018"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="18dp"
            android:paddingBottom="14dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CAPTIONS"
                android:textColor="#A9A5C0"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:paddingBottom="2dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pick one — it plays right away. BACK closes."
                android:textColor="#7E7B93"
                android:textSize="11.5sp"
                android:paddingBottom="10dp" />
            <ScrollView
                android:id="@+id/sub_side_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="none">
                <LinearLayout
                    android:id="@+id/sub_side_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>
    </FrameLayout>

    <!-- LIVE TV mini guide (AJ Sep 26): the web player's Guide panel, native — 🔴 Live Now,
         ★ Favorites, ↻ Continue Watching, then the full lineup under clearly separated,
         color-coded section bands. Tuning a channel keeps the panel OPEN (captions-panel
         pattern) so you can hop channels back to back; only BACK closes it. -->
    <FrameLayout
        android:id="@+id/live_guide_panel"
        android:layout_width="340dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#D90E0C16"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="18dp"
            android:paddingBottom="14dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📺 TV GUIDE"
                android:textColor="#A9A5C0"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:paddingBottom="2dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="OK tunes it — the guide stays open. Hold OK to ★ a channel. BACK closes."
                android:textColor="#7E7B93"
                android:textSize="11.5sp"
                android:paddingBottom="8dp" />
            <ScrollView
                android:id="@+id/live_guide_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="none">
                <LinearLayout
                    android:id="@+id/live_guide_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>
    </FrameLayout>

    <!-- Skip intro (Netflix-style): appears only inside the learned intro window for the
         show, pre-focused so one OK press jumps past it -->
    <Button
        android:id="@+id/btn_skip_intro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="28dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:background="@drawable/btn_next_play"
        android:textColor="#0C0C14"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:text="Skip intro ⏭"
        android:visibility="gone" />

    <!-- next-up card, Netflix-style: compact translucent strip flush in the bottom-right
         corner; focus lands on "Play now" so a single OK press binges the next episode -->
    <LinearLayout
        android:id="@+id/next_up_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp"
        android:background="@drawable/next_up_bg"
        android:focusable="true"
        android:visibility="gone">

        <ImageView
            android:id="@+id/next_up_thumb"
            android:layout_width="150dp"
            android:layout_height="84dp"
            android:scaleType="centerCrop"
            android:background="#22FFFFFF"
            android:contentDescription="Next episode" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/next_up_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UP NEXT"
                android:textColor="#B7B4C6"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <TextView
                android:id="@+id/next_up_text"
                android:layout_width="216dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:maxLines="2"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/next_up_play"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:background="@drawable/btn_next_play"
                    android:textColor="#0C0C14"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:text="▶ Play now" />
                <Button
                    android:id="@+id/next_up_cancel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:background="@drawable/btn_next_dismiss"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    android:text="Dismiss" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
